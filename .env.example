# Where every lead goes. One switch for the pop-up, /contact/, both questionnaires and the quiz.
# ghl-webhook | ghl-api | email | log   (defaults to ghl-webhook when CONTACT_WEBHOOK_URL is set, else log)
LEAD_DESTINATION=

# ghl-webhook: an Inbound Webhook trigger URL from a workflow in her GoHighLevel sub-account.
CONTACT_WEBHOOK_URL=

# ghl-api: a Private Integration token for her sub-account (scope contacts.write, contacts.readonly) and its location ID.
GHL_TOKEN=
GHL_LOCATION_ID=

# email: Resend. LEAD_TO may be a comma separated list.
RESEND_API_KEY=
LEAD_FROM=CLT Realty Group <leads@cltrealtygroup.net>
LEAD_TO=candacethompsonrealtor@gmail.com
